# By Eye environment template.
# Copy these names into your environment, or into a keys.env file the
# loader can read. Never commit a real key. .env and *.env are
# gitignored in this repo; this .env.example file is the exception
# and must only ever contain placeholders.

# Required for live mode (the default): the hosted Meta Model API.
# Used for Muse Spark 1.3 reads and SAM 3.1 segmentation.
META_API_KEY=your-meta-model-api-key-here

# Optional, explicit only: Baseten hosting of Muse Spark Open
# (a Meta open weight model). Only used when a run names
# --mode baseten; never selected by default or by --mode auto.
BASETEN_API_KEY=your-baseten-api-key-here

# Optional, app only: where the mobile app reaches the plate server.
# EXPO_PUBLIC_API_URL=http://localhost:8000
